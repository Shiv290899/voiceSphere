datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================



























// ==========================================
// MODELS
// ==========================================

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  bio          String?
  language     String     @default("en")
  country      String?
  lastSeenAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Profile relationship
  profile UserProfile?

  // Social relationships
  followers Follow[] @relation("following")
  following Follow[] @relation("follower")

  // Blocks
  blockedUsers Block[] @relation("blocker")
  blockedBy    Block[] @relation("blocked")

  // Voice Rooms
  ownedRooms VoiceRoom[]  @relation("roomOwner")
  memberships RoomMember[]

  // Room Invites
  sentRoomInvites     RoomInvitation[] @relation("inviteSender")
  receivedRoomInvites RoomInvitation[] @relation("inviteReceiver")

  // Conversations
  conversations ConversationMember[]

  // Messages
  sentMessages Message[]

  // Social Feed
  posts    Post[]
  comments Comment[]
  likes    Like[]

  // Gifting
  giftTransactionsSent     GiftTransaction[] @relation("giftSender")
  giftTransactionsReceived GiftTransaction[] @relation("giftReceiver")

  // Wallet & Earnings
  wallet       Wallet?
  transactions WalletTransaction[]
  withdrawals  Withdrawal[]        @relation("userWithdrawals")

  // Moderation
  reportsFiled     Report[]     @relation("reporter")
  reportsReceived  Report[]     @relation("reportTargetUser")
  reviewedReports  Report[]     @relation("reportReviewer")
  reviewedPayouts  Withdrawal[] @relation("payoutReviewer")
  moderationAudits AuditLog[]   @relation("auditActor")

  // Notifications
  notifications Notification[]

  @@index([username])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model UserProfile {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  gender           String?
  dateOfBirth      DateTime?
  bio              String?
  country          String?
  language         String   @default("en")
  avatarUrl        String?
  coverUrl         String?
  level            Int      @default(1)
  experiencePoints Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Block {
  id            String   @id @default(uuid())
  blockerId     String
  blocker       User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerId, blockedUserId])
}

model Report {
  id              String       @id @default(uuid())
  reporterId      String
  reporter        User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId    String?
  targetUser      User?        @relation("reportTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetContentId String?      // Generic ID targeting custom posts or messages
  targetRoomId    String?
  targetRoom      VoiceRoom?   @relation(fields: [targetRoomId], references: [id], onDelete: Cascade)
  reason          String
  description     String?
  status          ReportStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?        @relation("reportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([status])
  @@index([createdAt])
}

model VoiceRoom {
  id              String       @id @default(uuid())
  ownerId         String
  owner           User         @relation("roomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        String       @default("chat")
  coverImageUrl   String?
  status          RoomStatus   @default(SCHEDULED)
  maxParticipants Int          @default(50)
  isPrivate       Boolean      @default(false)
  passwordHash    String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  members     RoomMember[]
  invitations RoomInvitation[]
  reports     Report[]
  giftsSent   GiftTransaction[]

  @@index([ownerId])
  @@index([status])
}

model RoomMember {
  id          String         @id @default(uuid())
  roomId      String
  room        VoiceRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        RoomMemberRole @default(LISTENER)
  joinedAt    DateTime       @default(now())
  leftAt      DateTime?
  isMuted     Boolean        @default(false)
  isSpeaking  Boolean        @default(false)
  handRaised  Boolean        @default(false)

  @@unique([roomId, userId])
}

model RoomInvitation {
  id          String               @id @default(uuid())
  roomId      String
  room        VoiceRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                 @relation("inviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                 @relation("inviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      RoomInvitationStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  respondedAt DateTime?

  @@index([receiverId])
}

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType @default(DIRECT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt          DateTime     @default(now())
  lastReadMessageId String?

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  messageType    MessageType  @default(TEXT)
  content        String
  mediaUrl       String?
  replyToMessageId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
}

model Post {
  id         String         @id @default(uuid())
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  visibility PostVisibility @default(PUBLIC)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  media    PostMedia[]
  comments Comment[]
  likes    Like[]

  @@index([authorId])
  @@index([createdAt])
}

model PostMedia {
  id           String  @id @default(uuid())
  postId       String
  post         Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  type         String  // "IMAGE", "VIDEO"
  url          String
  thumbnailUrl String?
  metadata     String? // JSON metadata string
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes Like[]

  @@index([postId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Gift {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  iconUrl     String?
  coinCost    Int
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  
  transactions GiftTransaction[]
}

model GiftTransaction {
  id         String     @id @default(uuid())
  senderId   String
  sender     User       @relation("giftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User       @relation("giftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  roomId     String?
  room       VoiceRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  giftId     String
  gift       Gift       @relation(fields: [giftId], references: [id], onDelete: Cascade)
  quantity   Int
  totalCoins Int
  createdAt  DateTime   @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinBalance    Int      @default(0) // Used to buy/send gifts
  earningBalance Int      @default(0) // Received from gifts, withdrawable
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  walletId      String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  type          WalletTransactionType
  amount        Int                     // Signed: negative for debit, positive for credit
  balanceBefore Int
  balanceAfter  Int
  referenceType String?                 // "GIFT", "PAYMENT", "WITHDRAWAL"
  referenceId   String?                 // Reference ID of target entity
  status        WalletTransactionStatus @default(PENDING)
  metadata      String?                 // JSON metadata string
  createdAt     DateTime                @default(now())

  @@index([userId, createdAt])
}

model Withdrawal {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation("userWithdrawals", fields: [userId], references: [id], onDelete: Cascade)
  amount          Int              // Amount in base units of coin/earning
  currency        String           @default("USD")
  status          WithdrawalStatus @default(PENDING)
  paymentMethod   String           // "STRIPE", "RAZORPAY", "BANK_TRANSFER"
  paymentDetails  String?          // Encrypted or private payout details
  reviewedById    String?
  reviewedBy      User?            @relation("payoutReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())

  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      String?          // JSON data string
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("auditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // e.g. "BAN_USER", "DELETE_ROOM", "ADJUST_WALLET"
  targetType String   // "USER", "VOICEROOM", "POST"
  targetId   String?
  details    String?  // JSON context string
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
  CLOSED
}

enum RoomMemberRole {
  HOST
  CO_HOST
  SPEAKER
  LISTENER
  MODERATOR
}

enum RoomInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  FILE
  SYSTEM
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum WalletTransactionType {
  PURCHASE
  GIFT_SENT
  GIFT_RECEIVED
  REFUND
  WITHDRAWAL
  BONUS
  ADMIN_ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum NotificationType {
  FOLLOW
  MESSAGE
  ROOM_INVITE
  ROOM_STARTED
  GIFT
  COMMENT
  LIKE
  SYSTEM
  MODERATION
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}
