NODE_ENV=development
PORT=3000

# Database
# For docker-compose, this is: postgresql://postgres:postgres@localhost:5432/voicesphere?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voicesphere?schema=public

# Redis
# For docker-compose, this is: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_ACCESS_SECRET=voicesphere_jwt_access_super_secret_key_12345
JWT_REFRESH_SECRET=voicesphere_jwt_refresh_super_secret_key_12345

# Clients & APIs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:3000

# File Storage
# When USE_MOCK_STORAGE is true, uploads are stored locally under apps/api/uploads
USE_MOCK_STORAGE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-key
AWS_SECRET_ACCESS_KEY=mock-secret
AWS_S3_BUCKET=voicesphere-bucket

# LiveKit (Real-time Voice)
# When USE_MOCK_LIVEKIT is true, token generation returns a mock token and no external server is contacted
USE_MOCK_LIVEKIT=true
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=mock-livekit-key
LIVEKIT_API_SECRET=mock-livekit-secret

# Payments (Razorpay & Stripe)
# When USE_MOCK_PAYMENT is true, payments simulate webhooks and success automatically
USE_MOCK_PAYMENT=true
RAZORPAY_KEY_ID=mock-rzp-key
RAZORPAY_KEY_SECRET=mock-rzp-secret
STRIPE_SECRET_KEY=mock-stripe-secret
STRIPE_WEBHOOK_SECRET=mock-stripe-webhook-secret

# Notifications (Firebase Cloud Messaging)
# When USE_MOCK_NOTIFICATIONS is true, notification sends are logged locally instead of pushed
USE_MOCK_NOTIFICATIONS=true
FCM_PROJECT_ID=mock-fcm-project
FCM_CLIENT_EMAIL=mock-fcm-email
FCM_PRIVATE_KEY=mock-fcm-private-key
